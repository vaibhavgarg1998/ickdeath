# Public (safe in the browser)
# Optional fallback for the pixel id. Prefer META_PIXEL_ID below.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ORDERS_WEBHOOK_URL=
NEXT_PUBLIC_SITE_URL=https://ickdeath.com

# Firebase web client (checkout + /admin)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# HDFC SmartGateway basic-auth kit (config.json field → env)
# Required: MERCHANT_ID, PAYMENT_PAGE_CLIENT_ID, API_KEY
# API_KEY → HDFC_API_KEY
# MERCHANT_ID → HDFC_MERCHANT_ID
# PAYMENT_PAGE_CLIENT_ID → HDFC_PAYMENT_PAGE_CLIENT_ID
# BASE_URL → HDFC_BASE_URL
# ENABLE_LOGGING → HDFC_ENABLE_LOGGING
# production, prod, and live all use the live host. The UAT host is rejected.
HDFC_ENV=production
HDFC_MERCHANT_ID=
HDFC_PAYMENT_PAGE_CLIENT_ID=
HDFC_API_KEY=
HDFC_BASE_URL=https://smartgateway.hdfc.bank.in
HDFC_ENABLE_LOGGING=false
# Optional. Only if the dashboard also gave you JWE keys (real PEM files, not placeholders).
HDFC_KEY_UUID=
HDFC_PUBLIC_KEY=
HDFC_PRIVATE_KEY=

# Firebase Admin (server — marks orders paid after HDFC confirms the charge)
# From a Firebase service account JSON:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WhatsApp Cloud API (server — order updates + inbound track replies)
# See docs/whatsapp-setup.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_CONFIRMED=ickdeath_order_confirmed
WHATSAPP_TEMPLATE_PACKED=ickdeath_order_packed
WHATSAPP_TEMPLATE_SHIPPED=ickdeath_order_shipped
WHATSAPP_TEMPLATE_DELIVERED=ickdeath_order_delivered
WHATSAPP_TEMPLATE_CANCELLED=ickdeath_order_cancelled

# Product price is in src/lib/product.ts (unitPricePaise)

# Meta Conversions API (server only — never NEXT_PUBLIC_)
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Leave empty in production. While set, server events show on Meta's Test Events tab.
META_TEST_EVENT_CODE=
