# Public (safe in the browser)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ORDERS_WEBHOOK_URL=
NEXT_PUBLIC_SITE_URL=
# When the storefront is on GitHub Pages, point checkout APIs at a Vercel (or similar) host:
# NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app

# Firebase web client (checkout + /admin)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Razorpay (Key ID is public; Key Secret is server-only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Firebase Admin (server — marks orders paid after Razorpay verify)
# From a Firebase service account JSON:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# WhatsApp Cloud API (server — order updates + inbound track replies)
# See docs/whatsapp-setup.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_CONFIRMED=ickdeath_order_confirmed
WHATSAPP_TEMPLATE_PACKED=ickdeath_order_packed
WHATSAPP_TEMPLATE_SHIPPED=ickdeath_order_shipped
WHATSAPP_TEMPLATE_DELIVERED=ickdeath_order_delivered
WHATSAPP_TEMPLATE_CANCELLED=ickdeath_order_cancelled

# Product price is in src/lib/product.ts (unitPricePaise)
