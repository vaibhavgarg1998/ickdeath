rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Guest checkout can create pending orders from the website.
      allow create: if request.resource.data.keys().hasAll([
          'orderId', 'createdAt', 'contact', 'address',
          'quantity', 'amountPaise', 'paymentMethod',
          'paymentStatus', 'orderStatus'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.orderStatus == 'confirmed'
        && request.resource.data.paymentMethod == 'hdfc';

      // Guests can fetch a single order by ID for tracking.
      allow get: if true;

      // Phone tracking: a query must prove contact.phone is at least 10 chars
      // (equality to a mobile number). Unconstrained list is denied because of
      // the __track_sentinel__ document (empty phone). Admins can still list all.
      allow list: if request.auth != null
        || (resource.data.contact.phone is string
            && resource.data.contact.phone.size() >= 10);

      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Phone → order ID index for extra lookup paths.
    match /phoneIndex/{phone}/orders/{orderId} {
      allow create: if phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.orderId == orderId;
      allow get, list: if true;
      allow update, delete: if false;
    }

    // Restaurant monthly-subscription leads. Guests can create; only admins read or update status.
    match /restaurantSubscriptions/{subscriptionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'id', 'name', 'restaurantName', 'phone', 'email',
          'status', 'plan', 'source', 'createdAt'
        ])
        && request.resource.data.id == subscriptionId
        && request.resource.data.id is string
        && request.resource.data.status == 'new'
        && request.resource.data.plan == 'monthly'
        && request.resource.data.source == 'ickdeath-website'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() >= 2
        && request.resource.data.restaurantName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$')
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() >= 20
        && request.resource.data.createdAt.size() <= 40;

      allow get, list: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'contacted', 'active']
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // Storefront button-click counters. Guests may increment; only admins read.
    match /analytics/{docId} {
      allow create, update: if true;
      allow get, list: if request.auth != null;
      allow delete: if false;
    }
  }
}
